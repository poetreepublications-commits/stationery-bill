# Copy to deploy/.env and fill in. Never commit the real .env.
DOMAIN=orders.yourdomain.com
DB_PASSWORD=change-this-to-a-long-random-password
JWT_SECRET=change-this-to-a-64-char-random-string
BACKUP_RETENTION_DAYS=30

# Email (optional now; without SMTP, emails are logged on the server instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Poetree Publications <orders@yourdomain.com>
